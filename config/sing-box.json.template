{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "127.0.0.1",
      "listen_port": 10000,
      "users": [
        {
          "uuid": "${CLIENT_UUID}"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/edge/${WS_PATH}"
      }
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "residential-egress",
      "server": "${RES_PROXY_HOST}",
      "server_port": ${RES_PROXY_PORT},
      "version": "5",
      "username": "${RES_PROXY_USER}",
      "password": "${RES_PROXY_PASS}",
      "network": "tcp"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "final": "residential-egress"
  }
}
